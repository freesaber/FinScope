{
  "name": "finscope",
  "version": "0.2.0",
  "description": "FinScope 财务透镜：上市公司财报透视与风险线索分析客户端",
  "main": "electron/main.cjs",
  "author": "FinScope contributors",
  "license": "MIT",
  "repository": "https://github.com/freesaber/FinScope.git",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "electron scripts/smoke.cjs",
    "check:live": "node scripts/check-live.cjs",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.freesaber.finscope",
    "productName": "FinScope",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "FinScope-Setup-${version}-${arch}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "FinScope 财务透镜",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "deleteAppDataOnUninstall": false
    }
  }
}
